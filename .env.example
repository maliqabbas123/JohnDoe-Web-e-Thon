# Copy to .env for local development. Matches docker-compose.yml.
DATABASE_URL="postgresql://exam:exam_local_dev@localhost:5434/exam_system?schema=public"

# Optional. Comma-separated origins allowed to call the API from a browser
# when the frontend is served from a different origin.
ALLOWED_ORIGINS=""

# Public API origin used in QR codes on issued reports.
# PUBLIC_BASE_URL="https://api.example.com"
